{
  "id": "/",
  "name": "SwimPro - Professional Swimming App",
  "short_name": "SwimPro",
  "description": "Registro personal de tiempos, competencias, objetivos, temporadas y progreso de natación.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
